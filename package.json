{
  "name": "darkuniverse-hub",
  "version": "1.0.0",
  "private": true,
  "description": "DarkUniverse Hub - Tools, resources & experiences for the DarkUniverse community.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "bot": "tsx bot/index.ts",
    "bot:register": "tsx bot/register.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
