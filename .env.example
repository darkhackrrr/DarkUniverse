# ---------------------------------------------------------------------------
# DarkUniverse Hub - Environment Variables
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` or expose any of these values to the client.
# ---------------------------------------------------------------------------

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical production URL (used for SEO metadata, sitemap, OAuth redirects).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database (PostgreSQL + Prisma) ───────────────────────────────────────────
# Any PostgreSQL provider works: Neon, Supabase, Vercel Postgres, Railway, etc.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/darkuniverse?schema=public"
# Optional: used by Prisma migrations when your provider uses a pooled URL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/darkuniverse?schema=public"

# ── Authentication / Discord OAuth ───────────────────────────────────────────
# Create an application at https://discord.com/developers/applications
# OAuth2 -> Redirects -> add: {NEXT_PUBLIC_SITE_URL}/api/auth/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Random 32+ character string used to sign session cookies (openssl rand -base64 48)
AUTH_SECRET=""

# ── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated Discord user IDs that receive the ADMIN role on login.
# Users listed here are also promoted automatically on first sign-in.
ADMIN_DISCORD_IDS=""

# ── Optional integrations ────────────────────────────────────────────────────
# Discord bot token (used by Discord avatar/banner preview + invite lookups).
DISCORD_BOT_TOKEN=""
# Roblox Open Cloud API key (optional - public endpoints work without a key).
ROBLOX_API_KEY=""
# Shared server-side secret required by mutating/privileged API routes.
API_SECRET=""

# ── Public community links (safe to expose to the browser) ───────────────────
# Leave unset until the Discord server exists - the site renders a
# "coming soon" state instead of a link.
# NEXT_PUBLIC_DISCORD_URL=""
NEXT_PUBLIC_YOUTUBE_URL="https://youtube.com/DarkHackerrr"
NEXT_PUBLIC_ROBLOX_GROUP_URL="https://www.roblox.com/share/g/291490614"

# ── Rate limiting ────────────────────────────────────────────────────────────
# Requests per minute per IP for public API routes.
RATE_LIMIT_MAX="60"
